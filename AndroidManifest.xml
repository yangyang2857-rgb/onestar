<?xml version="1.0" encoding="utf-8"?>
<!--
  versionCode 是独立流水号，与 versionName 无换算关系：只增不减、永不复用（v6.5=20 / v6.6=21 / v6.7=22 / 0.12.2=23）。
  规则见 CHANGELOG.md，build.sh 会在构建前校验它不小于历史最大值。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yangyang2857rgb.onestar"
    android:versionCode="23"
    android:versionName="0.12.2">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".StarWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 系统语言变了，小组件文字也要跟着换 -->
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/star_widget_info" />
        </receiver>
    </application>
</manifest>
