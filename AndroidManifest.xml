<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yangyang2857rgb.onestar"
    android:versionCode="17"
    android:versionName="6.2">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />

    <application
        android:label="拾光"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".StarWidget"
            android:exported="false"
            android:label="拾光 · 今日星">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/star_widget_info" />
        </receiver>
    </application>
</manifest>
